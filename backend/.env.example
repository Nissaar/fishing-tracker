# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
NODE_ENV=production
PORT=5000
# LOG_LEVEL=info

# Database (the compose file creates it; DB_HOST is the compose service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fishing_tracker
DB_USER=postgres
DB_PASSWORD=

# Sessions and tokens: long random strings, for example `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRE=7d
SESSION_SECRET=

# Public addresses of the site (scheme included)
FRONTEND_URL=
CORS_ORIGIN=

# Google sign-in (Google Cloud console -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Weather providers (the app uses what is set)
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=

# Contact form mail
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_EMAIL=
